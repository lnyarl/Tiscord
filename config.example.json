{
  "behavior": {
    "language": "en",
    "group_messages": true,
    "group_window_seconds": 300,
    "send_key": "enter",
    "start_mode": "normal",
    "korean_shortcuts": true,
    "restore_unread": true
  },
  "layout": {
    "style": "plain",
    "author_name": "username",
    "group_spacing": 0,
    "show_timestamps": true,
    "timestamp_format": "HH:mm",
    "input_max_lines": 3,
    "input_gap_lines": 1,
    "show_metadata": true,
    "show_typing": true,
    "show_activity": true
  },
  "logging": {
    "level": "debug"
  }
}
